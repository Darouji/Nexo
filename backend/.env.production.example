# NEXO ERP/CRM - ejemplo de configuración para producción
# Este archivo es solo una plantilla.
# NO colocar secretos reales en archivos versionados.

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-production-secret-key
DJANGO_DEBUG=False
DJANGO_ENABLE_API_DOCS=False
DJANGO_ALLOWED_HOSTS=example.invalid,example.invalid,example.invalid

# Frontend / CORS / CSRF
# Ajustar al dominio real donde quedará React.
DJANGO_CORS_ALLOWED_ORIGINS=https://example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid

# Localización
DJANGO_LANGUAGE_CODE=es-cl
DJANGO_TIME_ZONE=America/Santiago

# Base de datos productiva
DB_ENGINE=postgres
DB_NAME=nexo_v2
DB_USER=nexo_v2_user
DB_PASSWORD=replace-this-with-a-secure-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Django REST Framework
DRF_PAGE_SIZE=50
DRF_TOKEN_EXPIRE_HOURS=12
DRF_ANON_THROTTLE_RATE=100/hour
DRF_USER_THROTTLE_RATE=1000/hour

# Logging
DJANGO_LOG_LEVEL=INFO

# Seguridad producción
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Tamaño máximo de archivos
# 30 MB por defecto. Ajustar solo si NEXO lo necesita.
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=31457280
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=31457280